{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEOS engineering dataset submission manifest (not runtime approval)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "data_origin",
    "input_file",
    "input_sha256",
    "billing_volume_state",
    "source_record_ids",
    "material_evidence_ids",
    "model_conditions_record_ids",
    "review_status",
    "review_record_id"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "data_origin": {
      "enum": [
        "TEACHING",
        "SYNTHETIC",
        "PUBLISHED_CASE",
        "MEASURED"
      ]
    },
    "input_file": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "billing_volume_state": {
      "const": "bank"
    },
    "source_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "material_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_conditions_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT TESTED"
      ]
    },
    "review_record_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_record_ids": {
            "minItems": 1
          },
          "material_evidence_ids": {
            "minItems": 1
          },
          "model_conditions_record_ids": {
            "minItems": 1
          },
          "review_record_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}